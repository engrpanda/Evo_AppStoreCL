<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pin_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/pin_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="@integer/pin_orientation">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/pin_logo"
                android:layout_height="@dimen/pin_logo"
                app:cardBackgroundColor="#0B1220"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/evologo" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/header_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pin_prompt"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_search" />

            <TextView
                android:id="@+id/tv_pin_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_pin_dots" />

            <TextView
                android:id="@+id/tv_pin_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="18dp"
                android:text="@string/pin_wrong"
                android:textColor="@color/status_error"
                android:textSize="@dimen/text_version"
                android:textStyle="bold"
                android:visibility="invisible" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/pin_gap"
            android:layout_height="@dimen/pin_gap" />

        <GridLayout
            android:id="@+id/pin_pad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3" />
    </LinearLayout>
</FrameLayout>
